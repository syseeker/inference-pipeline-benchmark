            "total_estimated_runs": 26
        },

        "phase6_secondary_confirmation": {
            "description": "Sweep secondary dimensions against TWO contrasting baselines — confirms whether dimension matters and whether its effect is context-dependent",
            "baselines": {
                "baseline_A": {
                    "label": "compute-bound (small models, high concurrency)",
                    "models": ["qwen2.5-7b", "gemma2-9b", "yolov8-l"],
                    "mix_type": "llm+cv",
                    "concurrency_llm": 8,
                    "concurrency_cv_rps": 50,
                    "gpu_count": 1,
                    "quantization": "q4",
                    "output_length": "short",
                    "arrival_pattern": "burst",
                    "load_asymmetry": "equal"
                },
                "baseline_B": {
                    "label": "memory-bound (large model, moderate concurrency)",
                    "models": ["qwen2.5-72b", "qwen2.5-14b", "yolov8-l"],
                    "mix_type": "llm+cv",
                    "concurrency_llm": 4,
                    "concurrency_cv_rps": 50,
                    "gpu_count": 1,
                    "quantization": "q4",
                    "output_length": "short",
                    "arrival_pattern": "burst",
                    "load_asymmetry": "equal"
                },
                "rationale": "If a secondary dimension shows similar effect size across both baselines, it's universally applicable. If it differs, there's an interaction effect worth documenting (e.g., 'backend choice matters 3x more under memory pressure')."
            },
            "experiments": [
                {
                    "id": "secondary-output-length-{baseline}",
                    "description": "Does output length change the degradation ratio? (longer decode = more overlap time with neighbor)",
                    "vary": "output_length",
                    "values": ["short", "long"],
                    "run_against": ["baseline_A", "baseline_B"],
                    "estimated_runs": 4
                },
                {
                    "id": "secondary-input-size-{baseline}",
                    "description": "Does longer prefill cause neighbor disruption? (1000-token prompt = longer prefill burst)",
                    "vary": "input_size_llm",
                    "values": ["short-input", "long-input"],
                    "run_against": ["baseline_A", "baseline_B"],
                    "estimated_runs": 4
                },
                {
                    "id": "secondary-quantization-{baseline}",
                    "description": "FP16 doubles VRAM usage — tests VRAM pressure effect on contention",
                    "vary": "quantization",
                    "values": ["q4", "fp16"],
                    "run_against": ["baseline_A", "baseline_B"],
                    "filter": "baseline_B with fp16: qwen2.5-72b cannot fit (145GB) — substitute qwen2.5-27b fp16 (54GB) + qwen2.5-14b fp16 (28GB) = 82GB",
                    "estimated_runs": 4
                },
                {
                    "id": "secondary-backend-llm-{baseline}",
                    "description": "Same model, different execution engines — kernel pattern changes contention signature",
                    "vary": "inference_backend_llm",
                    "values": ["vllm", "trt-llm", "sglang", "llamacpp"],
                    "run_against": ["baseline_A", "baseline_B"],
                    "filter": "baseline_B with llamacpp: 72B not supported — substitute qwen2.5-27b",
                    "estimated_runs": 8
                },
                {
                    "id": "secondary-backend-cv-{baseline}",
                    "description": "Same CV model, different engines — kernel fusion level changes interleaving gaps",
                    "vary": "inference_backend_cv",
                    "values": ["pytorch", "onnx", "tensorrt"],
                    "run_against": ["baseline_A", "baseline_B"],
                    "estimated_runs": 6
                },
                {
                    "id": "secondary-asymmetry-{baseline}",
                    "description": "Unequal load distribution — does the heavy user starve the light user?",
                    "vary": "load_asymmetry",
                    "values": ["equal", "moderate", "extreme"],
                    "run_against": ["baseline_A", "baseline_B"],
                    "estimated_runs": 6
                },
                {
                    "id": "secondary-arrival-{baseline}",
                    "description": "Bursty arrival (synchronized requests) vs uniform spacing — tests queue depth spikes",
                    "vary": "arrival_pattern",
                    "values": ["burst", "uniform"],
                    "run_against": ["baseline_A", "baseline_B"],
                    "estimated_runs": 4
                }
            ],
            "total_estimated_runs": 36
        }
    },

