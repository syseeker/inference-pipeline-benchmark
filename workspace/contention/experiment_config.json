    "phases": {
        "phase0_concurrency_validation": {
            "description": "Validate that Triton achieves true multi-model concurrent GPU execution (not serialization). Must pass before proceeding.",
            "rationale": "If Triton serializes model backends at the CUDA context level, the entire experiment measures scheduling overhead, not GPU contention. This phase confirms the fundamental assumption.",
            "experiments": [
                {
                    "id": "validate-concurrent-kernels",
                    "description": "Run LLM + CV simultaneously, monitor GPU SM utilization at ms granularity via DCGM/nsight. If SM shows interleaved kernels from both models in the same time window, concurrency is confirmed.",
                    "models": ["qwen2.5-7b", "yolov8-l"],
                    "concurrency_llm": 4,
                    "concurrency_cv_rps": 50,
                    "monitoring": {
                        "tool": "dcgmi dmon or nsight systems",
                        "sample_interval_ms": 1,
                        "duration_s": 30,
                        "expected_signal": "overlapping SM activity from both model backends"
                    },
                    "pass_criteria": "SM utilization from both models visible in overlapping time windows (not alternating blocks)",
                    "fail_action": "If serialized: document as finding, pivot experiment to measure time-slicing overhead instead of GPU contention",
                    "estimated_runs": 1
                },
                {
                    "id": "validate-vlm-cv-concurrent",
                    "description": "VLM prefill + CV forward pass — confirm both use GPU simultaneously (VLM prefill is the most GPU-intensive operation)",
                    "models": ["qwen2.5-vl-7b", "rfdetr-base"],
                    "concurrency_llm": 2,
                    "concurrency_cv_rps": 50,
                    "input_size_vlm": "short-clip",
                    "monitoring": {
                        "tool": "dcgmi dmon or nsight systems",
                        "sample_interval_ms": 1,
                        "duration_s": 30
                    },
                    "pass_criteria": "VLM prefill kernels and CV inference kernels overlap in timeline",
                    "estimated_runs": 1
                },
                {
                    "id": "validate-standalone-vs-triton",
                    "description": "Compare single-model throughput: standalone vLLM vs vLLM-inside-Triton. Confirms Triton wrapper doesn't add overhead that confounds contention measurement.",
                    "models": ["qwen2.5-7b"],
                    "concurrency_llm": 4,
                    "compare": ["standalone-vllm", "triton-vllm-backend"],
                    "pass_criteria": "Throughput difference < 5% (Triton wrapper overhead negligible)",
                    "estimated_runs": 1
                }
            ],
            "total_estimated_runs": 3
        },

        "phase1_baselines": {
            "description": "Solo model baselines — each model in isolation, establishes 1.0x reference for degradation ratios",
            "experiments": [
                {
                    "id": "baseline-llm-{model_id}-{quant}-{output}",
                    "description": "Text generation baselines with quantization and output length sweep",
                    "category": "text_generation",
                    "sweep": {
                        "model_id": ["qwen2.5-7b", "qwen2.5-14b", "qwen2.5-27b", "qwen2.5-72b", "gemma2-9b", "llama3.1-8b", "mistral-7b"],
                        "quant": ["q4", "fp16"],
                        "output": ["short", "long"]
                    },
                    "filter": "qwen2.5-72b only runs q4 (fp16 requires 145GB, exceeds 98GB GPU)",
                    "gpu_count": 1,
                    "concurrency": 1,
                    "estimated_runs": 26
                },
                {
                    "id": "baseline-vlm-{model_id}-{input_size}",
                    "description": "Video VLM baselines with input size sweep",
                    "category": "vision_language",
                    "sweep": {
                        "model_id": ["gemma-vlm-32b", "qwen2.5-vl-7b", "qwen2.5-vl-72b"],
                        "input_size": ["short-clip", "long-clip"]
                    },
                    "filter": "qwen2.5-vl-72b runs at q4 quantization",
                    "gpu_count": 1,
                    "concurrency": 1,
                    "estimated_runs": 6
                },
                {
                    "id": "baseline-ilm-{model_id}",
                    "description": "Image/document understanding baselines",
                    "category": "image_language",
                    "sweep": {
                        "model_id": ["kosmos-2.5", "qwen2.5-vl-7b", "qwen2.5-vl-72b"]
                    },
                    "input": "document image",
                    "gpu_count": 1,
                    "concurrency": 1,
                    "estimated_runs": 3
                },
                {
                    "id": "baseline-cv-{model_id}",
                    "description": "Computer vision baselines",
                    "category": "computer_vision",
                    "sweep": {
                        "model_id": ["paddleocr", "yolov8-n", "yolov8-l", "rfdetr-base", "dinov2-base", "dinov2-large"]
                    },
                    "gpu_count": 1,
                    "concurrency": 1,
                    "estimated_runs": 6
                }
            ],
            "total_estimated_runs": 41
        },

        "phase2_concurrency_sweep": {
            "description": "Fixed model mix per category, sweep concurrency to find saturation curves",
            "experiments": [
                {
                    "id": "concurrency-llm-{level}",
                    "description": "Two LLMs at increasing concurrency",
                    "models": ["qwen2.5-7b", "gemma2-9b"],
                    "mix_type": "llm-only",
                    "sweep": {
                        "level": [1, 2, 4, 8, 16]
                    },
                    "gpu_count": 1,
                    "output_length": "short",
                    "estimated_runs": 5
                },
                {
                    "id": "concurrency-cv-{rps}",
                    "description": "Three CV models at increasing request rate",
                    "models": ["yolov8-l", "rfdetr-base", "dinov2-base"],
                    "mix_type": "cv-only",
                    "sweep": {
                        "rps": [1, 10, 50, 200]
                    },
                    "gpu_count": 1,
                    "estimated_runs": 4
                },
                {
                    "id": "concurrency-vlm-{level}",
                    "description": "Two video VLMs at increasing concurrency",
                    "models": ["gemma-vlm-32b", "qwen2.5-vl-7b"],
                    "mix_type": "vlm-only",
                    "sweep": {
                        "level": [1, 2, 4, 8]
                    },
                    "gpu_count": 1,
                    "input_size_vlm": "short-clip",
                    "estimated_runs": 4
                },
                {
                    "id": "concurrency-ilm-{level}",
                    "description": "Two image LMs at increasing concurrency",
                    "models": ["kosmos-2.5", "qwen2.5-vl-7b"],
                    "mix_type": "ilm-only",
                    "sweep": {
                        "level": [1, 2, 4, 8]
                    },
                    "gpu_count": 1,
                    "estimated_runs": 4
                }
            ],
            "total_estimated_runs": 17
        },

        "phase3_model_type_mix": {
            "description": "Fixed concurrency (c4/rps50), vary model composition across all 8 mix types",
            "experiments": [
                {
                    "id": "mix-llm-only",
                    "models": ["qwen2.5-7b", "qwen2.5-14b", "gemma2-9b"],
                    "mix_type": "llm-only",
                    "concurrency_llm": 4
                },
                {
                    "id": "mix-cv-only",
                    "models": ["yolov8-l", "rfdetr-base", "dinov2-base", "paddleocr"],
                    "mix_type": "cv-only",
                    "concurrency_cv_rps": 50
                },
                {
                    "id": "mix-vlm-ilm",
                    "description": "Video VLM + image LM — both transformer-based but different prefill patterns (multi-frame vs single-frame)",
                    "models": ["gemma-vlm-32b", "kosmos-2.5"],
                    "mix_type": "vlm+ilm",
                    "concurrency_llm": 4,
                    "input_vlm": "short-clip",
                    "input_ilm": "document"
                },
                {
                    "id": "mix-llm-cv",
                    "models": ["qwen2.5-14b", "gemma2-9b", "yolov8-l", "rfdetr-base"],
                    "mix_type": "llm+cv",
                    "concurrency_llm": 4,
                    "concurrency_cv_rps": 50
                },
                {
                    "id": "mix-vlm-cv",
                    "description": "Video VLM sustained prefill + high-throughput CV — tests whether CV suffers during video encoding bursts",
                    "models": ["gemma-vlm-32b", "yolov8-l", "dinov2-base"],
                    "mix_type": "vlm+cv",
                    "concurrency_llm": 4,
                    "concurrency_cv_rps": 50,
                    "input_size_vlm": "long-clip"
                },
                {
                    "id": "mix-llm-vlm",
                    "description": "LLM autoregressive decode + VLM video prefill bursts — tests ITL stability of LLM",
                    "models": ["gemma2-9b", "qwen2.5-vl-7b"],
                    "mix_type": "llm+vlm",
                    "concurrency_llm": 4,
                    "input_size_vlm": "short-clip"
                },
                {
                    "id": "mix-ilm-cv",
                    "description": "Image LM + CV — similar input modality (images) but different compute patterns (transformer decode vs CNN forward pass)",
                    "models": ["kosmos-2.5", "qwen2.5-vl-7b", "yolov8-l", "rfdetr-base"],
                    "mix_type": "ilm+cv",
                    "concurrency_llm": 4,
                    "concurrency_cv_rps": 50
                },
                {
                    "id": "mix-full",
                    "description": "All four categories simultaneously — maximum heterogeneity",
                    "models": ["qwen2.5-7b", "qwen2.5-vl-7b", "kosmos-2.5", "yolov8-l", "dinov2-base"],
                    "mix_type": "full-mix",
                    "concurrency_llm": 4,
                    "concurrency_cv_rps": 50,
                    "input_size_vlm": "short-clip"
                }
            ],
            "fixed": {
                "gpu_count": 1,
                "quantization": "q4",
                "output_length": "short",
                "arrival_pattern": "burst"
            },
            "total_estimated_runs": 8
        },

        "phase4_cross_type_contention": {
            "description": "Characterize specific contention interactions — one model as subject, sweep neighbor load",
            "experiments": [
                {
                    "id": "cross-llm-vs-cv-rps-{rps}",
                    "description": "Fixed LLM (qwen2.5-7b at c4), sweep CV RPS to find LLM disruption threshold",
                    "models": ["qwen2.5-7b", "yolov8-l"],
                    "subject": "qwen2.5-7b",
                    "metric_focus": "ITL stability, TTFT",
                    "sweep": {
                        "rps": [1, 10, 50, 200]
                    },
                    "concurrency_llm": 4,
                    "estimated_runs": 4
                },
                {
                    "id": "cross-vlm-prefill-vs-llm",
                    "description": "VLM encoding 10s video (40 frames, sustained GPU burst) while LLM decodes — measures ITL spikes in LLM",
                    "models": ["gemma-vlm-32b", "gemma2-9b"],
                    "subject": "gemma2-9b",
                    "metric_focus": "ITL P99 spike magnitude during VLM prefill window",
                    "input_size_vlm": "long-clip",
                    "concurrency_llm": 4,
                    "estimated_runs": 1
                },
                {
                    "id": "cross-ilm-vs-cv-rps-{rps}",
                    "description": "Fixed ILM (kosmos-2.5 at c4), sweep CV RPS — tests single-frame prefill vs CV contention",
                    "models": ["kosmos-2.5", "rfdetr-base"],
                    "subject": "kosmos-2.5",
                    "metric_focus": "TTFT and throughput degradation",
                    "sweep": {
                        "rps": [1, 10, 50, 200]
                    },
                    "concurrency_llm": 4,
                    "estimated_runs": 4
                },
                {
                    "id": "cross-cv-vs-llm-concurrency-{level}",
                    "description": "Fixed CV pipeline (rps50), sweep LLM concurrency to find CV disruption point",
                    "models": ["qwen2.5-14b", "yolov8-l", "rfdetr-base"],
                    "subject": "yolov8-l",
                    "metric_focus": "CV P95 latency increase",
                    "concurrency_cv_rps": 50,
                    "sweep": {
                        "level": [1, 4, 8, 16]
                    },
                    "estimated_runs": 4
                },
                {
                    "id": "cross-memory-pressure-{vram_level}",
                    "description": "VRAM utilization curve — 4 points from comfortable to near-OOM, all using qwen2.5-72b (42GB Q4) as anchor",
                    "sweep": {
                        "vram_level": [
                            {"pair": ["qwen2.5-72b", "qwen2.5-7b"], "total_gb": 46.5, "util_pct": 47, "label": "comfortable"},
                            {"pair": ["qwen2.5-72b", "qwen2.5-14b"], "total_gb": 50.5, "util_pct": 52, "label": "moderate"},
                            {"pair": ["qwen2.5-72b", "qwen2.5-27b"], "total_gb": 58, "util_pct": 59, "label": "high"},
                            {"pair": ["qwen2.5-vl-72b", "qwen2.5-72b"], "total_gb": 84, "util_pct": 86, "label": "extreme"}
                        ]
                    },
                    "subject": "both",
                    "metric_focus": "throughput degradation curve vs VRAM utilization — identify cliff point where KV cache eviction begins",
                    "concurrency_llm": 4,
                    "quantization": "q4",
                    "note": "Extreme case (84GB) runs at c2 to avoid immediate OOM. Others run at c4.",
                    "repetitions": 3,
                    "estimated_runs": 4
                },
                {
                    "id": "cross-size-scaling-{model_size}",
                    "description": "Same architecture (Qwen 2.5) at different sizes as subject under fixed CV load — how does model size affect contention vulnerability?",
                    "models_subject": ["qwen2.5-7b", "qwen2.5-14b", "qwen2.5-27b", "qwen2.5-72b"],
                    "models_neighbor": ["yolov8-l", "rfdetr-base"],
                    "metric_focus": "degradation ratio vs model size — linear? exponential? flat?",
                    "concurrency_llm": 4,
                    "concurrency_cv_rps": 50,
                    "sweep": {
                        "model_size": ["7b", "14b", "27b", "72b"]
                    },
                    "estimated_runs": 4
                },
                {
                    "id": "cross-arch-validation-{arch}",
                    "description": "Same scenario (LLM + CV at rps50) across 3 architectures at ~7-9B size — validates that contention behavior generalizes beyond Qwen",
                    "models_subject": ["qwen2.5-7b", "llama3.1-8b", "mistral-7b"],
                    "models_neighbor": ["yolov8-l", "rfdetr-base"],
                    "metric_focus": "degradation ratio consistency across architectures — if all 3 show similar degradation, Qwen size-scaling results generalize",
                    "concurrency_llm": 4,
                    "concurrency_cv_rps": 50,
                    "sweep": {
                        "arch": ["qwen2.5-7b", "llama3.1-8b", "mistral-7b"]
                    },
                    "note": "If degradation ratios differ >20% across architectures, size-scaling conclusions from Qwen-only sweep may not generalize",
                    "estimated_runs": 3
                }
            ],
            "fixed": {
                "gpu_count": 1,
                "quantization": "q4",
                "output_length": "short"
            },
            "total_estimated_runs": 24
        },

        "phase5_gpu_scaling": {
            "description": "Repeat key scenarios with 2 and 4 GPUs — does adding GPUs eliminate contention or just redistribute it?",
            "experiments": [
                {
                    "id": "scale-{scenario}-{gpus}gpu",
                    "description": "GPU scaling for mix type and cross-type scenarios",
                    "sweep": {
                        "scenario": [
                            "mix-llm-only",
                            "mix-cv-only",
                            "mix-llm-cv",
                            "mix-vlm-cv",
                            "mix-ilm-cv",
