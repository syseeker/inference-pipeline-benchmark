                    "estimated_runs": 20
                },
                {
                    "id": "scale-concurrency-llm-{level}-{gpus}gpu",
                    "description": "Concurrency re-sweep at multi-GPU — compare saturation point shift",
                    "models": ["qwen2.5-7b", "gemma2-9b"],
                    "sweep": {
                        "level": [4, 8, 16],
                        "gpus": [2, 4]
