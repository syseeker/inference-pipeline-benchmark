    "dimensions": {
        "concurrency_llm": {
            "description": "Concurrent in-flight requests per LLM/VLM model",
            "options": [1, 2, 4, 8, 16],
            "default": 4
        },
        "concurrency_cv_rps": {
            "description": "Sustained requests per second for CV models",
            "options": [1, 10, 50, 200],
            "default": 50
        },
        "gpu_count": {
            "description": "Number of GPUs available",
            "options": [1, 2, 4],
            "default": 1
        },
        "output_length": {
            "description": "Max output tokens for LLM/VLM",
            "options": {
                "short": 32,
                "long": 512
            },
            "default": "short"
        },
        "input_size_llm": {
            "description": "Input prompt length in tokens for LLM",
            "options": {
                "short-input": 50,
                "long-input": 1000
            },
            "default": "short-input"
        },
        "input_size_vlm": {
            "description": "Input video specification for VLM",
            "options": {
                "short-clip": {"resolution": [224, 224], "duration_s": 3, "fps": 1, "frames": 3},
                "long-clip": {"resolution": [1280, 720], "duration_s": 10, "fps": 4, "frames": 40}
            },
            "default": "short-clip"
        },
        "input_size_cv": {
            "description": "Input image resolution for CV models",
            "options": {
                "cv-small": [320, 320],
                "cv-large": [1280, 1280]
            },
            "default": "cv-small"
        },
        "quantization": {
            "description": "Model quantization for LLM/VLM",
            "options": ["q4", "fp16"],
            "default": "q4"
        },
        "inference_backend_llm": {
            "description": "Execution engine for LLM/VLM models — determines GPU kernel pattern and contention signature",
            "options": {
                "vllm": {"engine": "vLLM", "kernel_pattern": "many small PagedAttention kernels", "contention": "frequent gaps, neighbors can interleave"},
                "trt-llm": {"engine": "TensorRT-LLM", "kernel_pattern": "fused large kernels, compiled graph", "contention": "long GPU bursts, starves neighbors"},
                "sglang": {"engine": "SGLang", "kernel_pattern": "RadixAttention, prefix sharing", "contention": "less total compute, less contention"},
                "llamacpp": {"engine": "llama.cpp", "kernel_pattern": "layer-by-layer, frequent CPU-GPU sync", "contention": "many sync points, lots of interleaving"}
            },
            "default": "vllm"
        },
        "inference_backend_cv": {
            "description": "Execution engine for CV models — determines kernel fusion and scheduling gaps",
            "options": {
                "pytorch": {"engine": "PyTorch eager", "kernel_pattern": "many small kernel launches", "contention": "more scheduling gaps for LLM"},
                "onnx": {"engine": "ONNX Runtime (CUDA)", "kernel_pattern": "some graph optimization", "contention": "moderate interleaving"},
                "tensorrt": {"engine": "TensorRT", "kernel_pattern": "few large fused kernels", "contention": "long bursts, less interleaving"}
            },
            "default": "pytorch"
        },
        "serving_platform": {
            "description": "Fixed serving platform for multi-model concurrent GPU execution",
            "fixed": "triton",
            "note": "Triton enables true multi-model concurrent GPU execution via CUDA streams. Not a variable — fixed across all experiments."
        },
        "load_asymmetry": {
            "description": "Load ratio between models (heaviest:lightest)",
            "options": {
                "equal": "1:1",
                "moderate": "4:1",
                "extreme": "16:1"
            },
            "default": "equal"
        },
        "arrival_pattern": {
            "description": "How requests arrive over time",
            "options": ["burst", "uniform"],
            "default": "burst"
        }
    },

    "prompts": {
        "llm_short": [
            "What is CUDA?",
            "Name three GPU architectures.",
            "Define tensor parallelism in one sentence."
        ],
        "llm_long": [
            "Explain the complete memory hierarchy of a modern GPU, covering registers, shared memory, L1 cache, L2 cache, and global memory. Describe how data flows between these levels during a typical matrix multiplication kernel. Include the role of memory coalescing and bank conflicts. Discuss how the programmer can optimize memory access patterns to maximize throughput. Cover the differences between compute capability generations in terms of cache sizes and bandwidth. Finally, explain how unified memory and managed memory simplify programming but may impact performance.",
            "Write a detailed technical specification for a distributed inference system that serves multiple large language models across a GPU cluster. Cover model placement strategies, request routing, load balancing, fault tolerance, autoscaling policies, and latency budgets. Include specific numerical targets for tail latency percentiles and throughput requirements. Describe the monitoring and alerting infrastructure needed to maintain SLOs."
        ],
        "vlm_video": [
            "Describe what happens in this video in detail. Include the people visible, what they are wearing, what device is being used, and any interactions between people.",
            "Watch this video and answer: How many people are visible? What is the child doing? What is the relationship between the people shown?"
        ],
        "ilm_document": [
            "Read this document image. Extract all text fields and their values into a structured format.",
            "Identify the document type, list all form fields with their labels and filled values, and note any signatures or handwritten content."
        ]
    },

