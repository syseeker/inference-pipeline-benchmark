{
    "metadata": {
        "experiment": "heterogeneous-gpu-contention",
        "version": "2.0",
        "description": "Systematic contention benchmarking across text generation, vision-language, and computer vision models",
        "hardware_target": "NVIDIA RTX PRO 6000 Blackwell (98 GB VRAM)"
    },

    "fixed_methodology": {
        "warmup_rounds": 3,
        "measurement_rounds": 10,
        "gpu_sampling_interval_ms": 100,
        "temperature": 0.7,
        "timeout_per_request_s": 120,
        "inter_round_delay_s": 0,
        "statistical_rationale": "GPU inference on dedicated hardware is near-deterministic (<5% run-to-run variance). Contention effects are large (2-10x degradation), not subtle — clearly visible from a single run with 10 rounds. Standard statistical robustness concerns (confidence intervals, large sample sizes) do not apply to most scenarios in a controlled lab benchmark with fixed inputs and no production traffic confounders.",
        "repetitions": {
            "default": 1,
            "critical_scenarios": 3,
            "critical_scenarios_list": [
                "cross-memory-pressure-*"
            ],
            "rationale": "Memory-pressure scenarios near OOM are the ONE exception to low variance. KV cache eviction triggers non-deterministically (depends on exact allocation order at runtime), producing bimodal behavior — the model either fits comfortably or thrashes. This creates genuine run-to-run variance that single runs cannot capture. 3 repetitions reveal whether a result is stable or bimodal, and provide mean ± std for reporting."
        },
        "metrics_reporting": {
            "latency_percentiles": ["P50", "P95", "max"],
            "note": "With 10 measurement rounds × 2-3 prompts = 20-30 samples per run. P50 is the primary metric. P95 = 2nd-worst sample (indicative but noisy for tail). Max captures worst-case spikes. P99 not reported (insufficient samples)."
        },
        "model_load_measurement": {
            "enabled": true,
            "captures": ["time_to_first_ready_s", "vram_after_load_gb"],
            "rationale": "Cold start penalty is invisible to inference metrics but critical for deployment decisions"
        }
    },

